generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME  // Entrada / Receita
  EXPENSE // Saída / Despesa
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @unique
  phone     String?  // Telefone para integração com WhatsApp (ex: "5549999999999")
  salary    Float    @default(0) // Renda base ou salário fixo mensal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  categories   Category[]
  transactions Transaction[]
  installments Installment[]
  fixedExpenses FixedExpense[]

  @@map("users")
}

model Category {
  id        String          @id @default(uuid())
  name      String          @unique
  icon      String?
  type      TransactionType @default(EXPENSE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamentos
  transactions Transaction[]
  installments Installment[]
  fixedExpenses FixedExpense[]

  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(10, 2) // Até R$ 99.999.999,99 com 2 casas decimais
  type        TransactionType
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relacionamento com Usuário
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamento com Categoria (Opcional)
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Installment {
  id                String   @id @default(uuid())
  description       String
  totalAmount       Float    @map("total_amount")
  totalInstallments Int      @map("total_installments")
  installmentValue  Float    @map("installment_value")
  startDate         DateTime @map("start_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relacionamento com Usuário
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamento com Categoria
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("installments")
}

model FixedExpense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  dueDate     Int?     @map("due_date") // Dia do vencimento (opcional)
  isActive    Boolean  @default(true) @map("is_active") // Permite pausar uma assinatura

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("fixed_expenses")
}